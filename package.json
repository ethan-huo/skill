{
  "name": "skill",
  "version": "0.6.3",
  "description": "Install and remove agent skills from GitHub repositories.",
  "bin": {
    "skill": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "build": "./scripts/build.sh",
    "dev": "bun run src/cli.ts",
    "fmt": "bunx oxfmt .",
    "fmt:check": "bunx oxfmt --check .",
    "migrate:global-skills": "bun run scripts/migrate-skill-links.ts",
    "migrate:skills": "bun run scripts/migrate-skill-links.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run fmt:check && bun run typecheck && bun test"
  },
  "dependencies": {
    "@celados/argc": "^7.11.0",
    "@clack/core": "1.4.3",
    "@clack/prompts": "1.7.0",
    "@valibot/to-json-schema": "^1.6.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "oxfmt": "^0.46.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
