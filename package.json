{
	"name": "skill",
	"version": "0.10.2",
	"description": "Install and remove agent skills from GitHub repositories.",
	"bin": {
		"skill": "./src/cli.ts"
	},
	"type": "module",
	"scripts": {
		"build": "./scripts/build.sh",
		"dev": "bun run src/cli.ts",
		"fmt": "vp fmt",
		"migrate:global-skills": "bun run scripts/migrate-skill-links.ts",
		"migrate:skills": "bun run scripts/migrate-skill-links.ts",
		"typecheck": "harness typecheck",
		"test": "bun test",
		"check": "vp check && harness typecheck && fallow dead-code && bun test",
		"prepare": "vp config"
	},
	"dependencies": {
		"@celados/argc": "^11.0.0",
		"@clack/core": "1.4.3",
		"@clack/prompts": "1.7.0",
		"@valibot/to-json-schema": "^1.6.0",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@celados/harness": "^0.1.3",
		"@types/bun": "^1.3.12",
		"fallow": "^3.42.0",
		"tsrs": "0.24.0-ts7.1.0-beta",
		"typescript": "^7.0.2",
		"vite-plus": "^1.6.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
